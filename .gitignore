# =============================================================================
# .gitignore - Proyecto de Vapor
# =============================================================================
# Este archivo define qué archivos/directorios deben ser ignorados por Git
# para evitar conflictos con Google Drive y mantener el repositorio limpio
# =============================================================================

# =============================================================================
# WINDOWS
# =============================================================================
desktop.ini
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# =============================================================================
# IDE / EDITORES
# =============================================================================
.vscode/
.codex/
.gemini/
.opencode/
.idea/
*.swp
*.swo
*~

# =============================================================================
# PYTHON
# =============================================================================
.ruff_cache/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
ENV/

# =============================================================================
# LATEX - Archivos de compilación
# =============================================================================
# IMPORTANTE: El directorio build/ contiene TODOS los auxiliares
# Solo el PDF final se mantiene en el directorio raíz del proyecto LaTeX

# Directorio de compilación (CRÍTICO - evita sincronización innecesaria)
**/build/
!**/build/README.md

# Archivos auxiliares de LaTeX (por si se generan fuera de build/)
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.synctex*
*.synctex.gz
*.synctex.gz(busy)
*.auxlock
*.fdb_latexmk
*.fls
*.bbl
*.blg
*.run.xml
*.bcf
*.idx
*.ind
*.ilg
*.fls
*.nav
*.snm
*.vrb

# Archivos temporales de latexindent
*.bak
*.bak[0-9]
*.bak[0-9][0-9]
indent.log
*.indent.log

# Archivos temporales del validador LaTeX
.latex_validator_temp_content.tex
*.staging.log
*.plot.log

# TikZ cache
TikZ-Cache/

# =============================================================================
# BACKUPS Y TEMPORALES
# =============================================================================
*.tmp
*.temp
*.bak
*.backup
~$*
.~lock.*

# =============================================================================
# ARCHIVOS DE PROYECTO ESPECÍFICOS
# =============================================================================
# Backup antiguo del proyecto
Practica_Vapor_LaTeX_git_backup/

# Windows reserved names (pueden causar problemas)
nul
nul.*

# =============================================================================
# ARCHIVOS DE SISTEMA
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
