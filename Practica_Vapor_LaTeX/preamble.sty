% --- Custom Appendix Style ---
\newcounter{appendixcounter}
\renewcommand{\theappendixcounter}{\arabic{appendixcounter}} % Anexo 1, Anexo 2

\newcommand{\myappendix}[1]{%
    \cleardoublepage
    \thispagestyle{empty}
    \refstepcounter{appendixcounter}
    \setcounter{figure}{0} % Reiniciar contador de figuras
    \setcounter{table}{0}  % Reiniciar contador de tablas
    \renewcommand{\thefigure}{A.\arabic{figure}} % Formato A.1
    \renewcommand{\thetable}{A.\arabic{table}}   % Formato A.1
    \vspace*{\fill}
    \begin{center}
        \parbox{0.9\textwidth}{\centering\Huge\bfseries Anexo \theappendixcounter. #1}
    \end{center}
    \vspace*{\fill}
    \addcontentsline{toc}{section}{Anexo \theappendixcounter: #1}
    \normalfont % Reset font to normal
    \cleardoublepage
}

